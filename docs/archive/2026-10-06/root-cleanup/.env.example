# Copy to .env and adjust. Never commit the real .env.
# Local defaults only; nothing here is a production credential.

# --- Ports ---
# 9969 is the single public entry point: nginx serves the SPA and proxies the
# control plane, so the API is reachable at http://127.0.0.1:9969/api/... and
# nothing else is published to the host.
SON_PUBLIC_PORT=9969
# Non-container dev: API directly, and the Vite dev server (5173 is taken on
# this machine by an unrelated project, so the web uses 5174).
SON_API_PORT=9969
SON_WEB_PORT=5174

# --- State (改造开发方案.md 6.2) ---
# PostgreSQL and Redis are gone. State is one SQLite file plus a workspace tree,
# both under SON_DATA_DIR. The compose file bind-mounts SON_DATA_DIR to /data so
# the host can read the database, inspect a failed job's log, and copy a GGUF out.
SON_DATA_DIR=./runtime
SON_DB_PATH=./runtime/systemone.db
SON_WORKSPACE=./runtime/workspace

# --- GPU node ---
# Training, quantization and inference need an NVIDIA GPU. Start the worker with:
#   docker compose -f deploy/compose/docker-compose.prod.yml --profile worker up -d
# A base model must be present before training; set HF_HOME so it is cached in
# the mounted data directory rather than the container.
HF_HOME=./runtime/hf-cache
# Minimum VRAM for Qwen2.5-1.5B with LoRA is 12GB (需求方案.txt 8.1).