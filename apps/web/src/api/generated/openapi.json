{
  "openapi": "3.1.0",
  "info": {
    "title": "SystemOneStudio Control Plane",
    "description": "Control plane for the zero-code decision model training platform. The prediction surface is served separately per deployment at /v1/predict.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/datasets/preview": {
      "post": {
        "tags": [
          "datasets"
        ],
        "summary": "上传并预览",
        "description": "Step 2 of the wizard: upload, preview, auto-detect (需求方案.txt 5.2).",
        "operationId": "preview_api_datasets_preview_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_preview_api_datasets_preview_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/quality": {
      "post": {
        "tags": [
          "datasets"
        ],
        "summary": "数据质量报告",
        "description": "Step 3 of the wizard: composite score plus one-click suggestions.",
        "operationId": "quality_api_datasets_quality_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_quality_api_datasets_quality_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/split": {
      "post": {
        "tags": [
          "datasets"
        ],
        "summary": "数据划分 7:1.5:1.5",
        "description": "Fixed 7:1.5:1.5 split.\n\nThe caller cannot pass in their own split. There is one implementation of\nthis rule and it is the one that enforces the no-synthetic-in-test\nconstraint.",
        "operationId": "split_api_datasets_split_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_split_api_datasets_split_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SplitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/recommend-synth": {
      "post": {
        "tags": [
          "datasets"
        ],
        "summary": "合成参数推荐",
        "description": "Step 4 of the wizard: pre-filled synthesis parameters (需求方案.txt 5.4).",
        "operationId": "recommend_synth_api_datasets_recommend_synth_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_recommend_synth_api_datasets_recommend_synth_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SynthRecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/synth": {
      "post": {
        "tags": [
          "datasets"
        ],
        "summary": "智能数据合成",
        "description": "Step 4 of the wizard: generate samples and report fidelity + privacy.",
        "operationId": "synth_api_datasets_synth_post",
        "parameters": [
          {
            "name": "method",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SynthMethod",
              "default": "distribution_fit"
            }
          },
          {
            "name": "target_rows",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000,
              "title": "Target Rows"
            }
          },
          {
            "name": "augment_label",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Decision"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Augment Label"
            }
          },
          {
            "name": "target_ratio",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Target Ratio"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_synth_api_datasets_synth_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SynthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meta/jev-spec": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Jev Spec",
        "operationId": "jev_spec_meta_jev_spec_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JevSpecResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meta/echo-prediction": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Validate a prediction payload against the JEV output schema",
        "description": "Contract self-check for the frontend and integration tests.\n\nNot a real inference path: the actual /v1/predict lives in the\ninference service, mounted per deployment.",
        "operationId": "echo_prediction_meta_echo_prediction_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_preview_api_datasets_preview_post": {
        "properties": {
          "upload": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Upload"
          }
        },
        "type": "object",
        "required": [
          "upload"
        ],
        "title": "Body_preview_api_datasets_preview_post"
      },
      "Body_quality_api_datasets_quality_post": {
        "properties": {
          "upload": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Upload"
          }
        },
        "type": "object",
        "required": [
          "upload"
        ],
        "title": "Body_quality_api_datasets_quality_post"
      },
      "Body_recommend_synth_api_datasets_recommend_synth_post": {
        "properties": {
          "upload": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Upload"
          }
        },
        "type": "object",
        "required": [
          "upload"
        ],
        "title": "Body_recommend_synth_api_datasets_recommend_synth_post"
      },
      "Body_split_api_datasets_split_post": {
        "properties": {
          "upload": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Upload"
          }
        },
        "type": "object",
        "required": [
          "upload"
        ],
        "title": "Body_split_api_datasets_split_post"
      },
      "Body_synth_api_datasets_synth_post": {
        "properties": {
          "upload": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Upload"
          }
        },
        "type": "object",
        "required": [
          "upload"
        ],
        "title": "Body_synth_api_datasets_synth_post"
      },
      "Decision": {
        "type": "string",
        "enum": [
          "black",
          "white",
          "gray"
        ],
        "title": "Decision",
        "description": "Three-way judgement outcome.\n\nDeliberately NOT a boolean. The `gray` label is a first-class outcome that\nthreads through synthesis ratios, quality reports and per-label evaluation\nmetrics. Collapsing it into black/white silently drops the hardest cases."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "jev_spec_version": {
            "type": "string",
            "title": "Jev Spec Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "jev_spec_version"
        ],
        "title": "HealthResponse"
      },
      "JevFlags": {
        "properties": {
          "jev_format_compat": {
            "type": "boolean",
            "title": "Jev Format Compat",
            "default": true
          },
          "jev_training_compat": {
            "type": "boolean",
            "title": "Jev Training Compat",
            "default": true
          }
        },
        "type": "object",
        "title": "JevFlags",
        "description": "The two JEV compatibility switches.\n\nThese are two independent switches by requirement, not one toggle. They\ncontrol different layers and must be allowed to differ:\n\n* ``jev_format_compat``   -> input/output schema, prompt format, API shape\n* ``jev_training_compat`` -> training paradigm, hyperparameters, eval basis\n\nBoth default to enabled. When ``jev_format_compat`` is off the API still\nreturns the same four fields so callers keep a single parser, but the\nresponse is explicitly flagged as non-JEV via ``PredictResponse``'s\n``jev_compatible`` field."
      },
      "JevSpecResponse": {
        "properties": {
          "spec_version": {
            "type": "string",
            "title": "Spec Version"
          },
          "output_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Output Schema"
          },
          "default_flags": {
            "$ref": "#/components/schemas/JevFlags"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "spec_version",
          "output_schema",
          "default_flags",
          "note"
        ],
        "title": "JevSpecResponse",
        "description": "Machine-readable JEV contract served to the frontend.\n\nExposing the output schema lets apps/web generate the Playground result\nview and the format-compliance display from one source instead of\nduplicating the field list."
      },
      "PredictRequest": {
        "properties": {
          "model_version_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version Id",
            "description": "Pin a specific model version; omit to use the active deployment."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "PredictRequest",
        "description": "A single decision request.\n\nThe sample payload is schema-free: the field set is defined per scene, and\nthe platform must not reject a scene-specific field it has never seen. So\nunknown fields are allowed and passed through to the prompt template."
      },
      "PredictResponse": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "description": "判定结果: black / white / gray"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "风险评分"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "置信度"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason",
            "description": "决策依据 (required; capped at 200 chars under JEV format compat)"
          },
          "jev_compatible": {
            "type": "boolean",
            "title": "Jev Compatible",
            "description": "False when the scene runs with jev_format_compat disabled.",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "score",
          "confidence",
          "reason"
        ],
        "title": "PredictResponse",
        "description": "Decision output. Field set is identical whether or not JEV format\ncompatibility is on, so callers need only one parser.\n\n``jev_compatible`` tells the caller which contract they are actually\nholding. It is false when the scene runs with ``jev_format_compat``\ndisabled, in which case `reason` is no longer bound by the JEV schema."
      },
      "PreviewResponse": {
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          },
          "total_rows": {
            "type": "integer",
            "title": "Total Rows"
          },
          "label_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label Column"
          },
          "label_confidence": {
            "type": "string",
            "title": "Label Confidence"
          },
          "label_reason": {
            "type": "string",
            "title": "Label Reason"
          },
          "label_distribution": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Label Distribution"
          },
          "sensitive_fields": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Sensitive Fields"
          },
          "missing_cells": {
            "type": "integer",
            "title": "Missing Cells"
          },
          "missing_rate": {
            "type": "number",
            "title": "Missing Rate"
          },
          "preview_limit": {
            "type": "integer",
            "title": "Preview Limit",
            "description": "需求方案.txt 5.2 shows the first 5 rows",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "columns",
          "rows",
          "total_rows",
          "label_column",
          "label_confidence",
          "label_reason",
          "label_distribution",
          "sensitive_fields",
          "missing_cells",
          "missing_rate"
        ],
        "title": "PreviewResponse"
      },
      "QualityResponse": {
        "properties": {
          "score": {
            "type": "number",
            "title": "Score"
          },
          "grade": {
            "type": "string",
            "title": "Grade"
          },
          "dimensions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Dimensions"
          },
          "label_distribution": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Label Distribution"
          },
          "anomalies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Anomalies"
          },
          "masked_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Masked Fields"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggestions"
          }
        },
        "type": "object",
        "required": [
          "score",
          "grade",
          "dimensions",
          "label_distribution",
          "anomalies",
          "masked_fields",
          "suggestions"
        ],
        "title": "QualityResponse"
      },
      "SplitResponse": {
        "properties": {
          "train_rows": {
            "type": "integer",
            "title": "Train Rows"
          },
          "valid_rows": {
            "type": "integer",
            "title": "Valid Rows"
          },
          "test_rows": {
            "type": "integer",
            "title": "Test Rows"
          },
          "test_contains_synth": {
            "type": "boolean",
            "title": "Test Contains Synth"
          },
          "label_distribution": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            "type": "object",
            "title": "Label Distribution"
          },
          "undersized_groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Undersized Groups"
          }
        },
        "type": "object",
        "required": [
          "train_rows",
          "valid_rows",
          "test_rows",
          "test_contains_synth",
          "label_distribution",
          "undersized_groups"
        ],
        "title": "SplitResponse"
      },
      "SynthMethod": {
        "type": "string",
        "enum": [
          "distribution_fit",
          "small_sample_derive",
          "rule_injection"
        ],
        "title": "SynthMethod"
      },
      "SynthRecommendationResponse": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method"
          },
          "total_rows": {
            "type": "integer",
            "title": "Total Rows"
          },
          "black_white_ratio": {
            "type": "number",
            "title": "Black White Ratio"
          },
          "augment_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Augment Label"
          },
          "augment_rows": {
            "type": "integer",
            "title": "Augment Rows"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "describe": {
            "type": "string",
            "title": "Describe"
          }
        },
        "type": "object",
        "required": [
          "method",
          "total_rows",
          "black_white_ratio",
          "augment_label",
          "augment_rows",
          "reasons",
          "describe"
        ],
        "title": "SynthRecommendationResponse"
      },
      "SynthResponse": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method"
          },
          "rows": {
            "type": "integer",
            "title": "Rows"
          },
          "label_distribution": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Label Distribution"
          },
          "fidelity_score": {
            "type": "number",
            "title": "Fidelity Score"
          },
          "fidelity_verdict": {
            "type": "string",
            "title": "Fidelity Verdict"
          },
          "fidelity_notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fidelity Notes"
          },
          "privacy_lines": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Privacy Lines"
          },
          "reversible_risk": {
            "type": "string",
            "title": "Reversible Risk"
          },
          "all_rows_marked_synthetic": {
            "type": "boolean",
            "title": "All Rows Marked Synthetic"
          }
        },
        "type": "object",
        "required": [
          "method",
          "rows",
          "label_distribution",
          "fidelity_score",
          "fidelity_verdict",
          "fidelity_notes",
          "privacy_lines",
          "reversible_risk",
          "all_rows_marked_synthetic"
        ],
        "title": "SynthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}