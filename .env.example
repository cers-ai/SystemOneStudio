# Copy to .env and adjust. Never commit the real .env.
# Local defaults only; nothing here is a production credential.

# --- Ports ---
# 9969 is the single public entry point: nginx serves the SPA and proxies the
# control plane, so the API is reachable at http://127.0.0.1:9969/api/... and
# nothing else is published to the host.
SON_PUBLIC_PORT=9969
# Non-container dev: API directly, and the Vite dev server (5173 is taken on
# this machine by an unrelated project, so the web uses 5174).
SON_API_PORT=9969
SON_WEB_PORT=5174

# --- Services ---
# Hostnames resolve inside the compose network; override for local (non-Docker)
# runs.
SON_DATABASE_URL=postgresql+psycopg://son:son_local_only@127.0.0.1:5432/sonstudio
SON_REDIS_URL=redis://127.0.0.1:6379/0

POSTGRES_USER=son
POSTGRES_PASSWORD=son_local_only
POSTGRES_DB=sonstudio

# --- Storage ---
# Metadata and tabular datasets live in PostgreSQL. Model artifacts -- adapters,
# merged weights, GGUF, 2-6GB binaries -- live on this path, which is a named
# volume in the compose file.
#
# There is deliberately no object store. 需求方案.txt 11 lists MinIO, but nothing
# in the MVP needs it; the analysis and the deviation record are in
# 技术方案.md 3.1 and section 10. Object storage returns in 阶段二, where
# multiple nodes and the model marketplace make it the right tool.
SON_MODELS_DIR=D:/SystemOneStudio/models

# --- GPU node (not started by the compose files here) ---
# Training, GGUF quantization and llama.cpp inference need an NVIDIA GPU. This
# machine has none, so those services are absent rather than stubbed.
SON_GPU_DATA_DIR=/data