# Local CPU control-plane example; do not put credentials in Git.
# The current Compose has only studio; it does not have a worker profile.
SON_PUBLIC_PORT=9969
SON_WEB_PORT=5174

# Compose resolves relative bind paths under deploy/compose.
# Set SON_DATA_DIR to an absolute host path when you need a predictable location.
SON_DATA_DIR=./runtime

# Host development paths; Compose overrides these to /data/...
SON_DB_PATH=./runtime/systemone.db
SON_WORKSPACE=./runtime/workspace
SON_EXECUTION_MODE=cpu

# Reserved GPU cache location; GPU execution is not verified on this machine.
HF_HOME=./runtime/hf-cache
