# Copy to .env and adjust. Never commit the real .env.
# Local defaults only; nothing here is a production credential.

SON_DATABASE_URL=postgresql+psycopg://son:son_local_only@127.0.0.1:5432/sonstudio
SON_REDIS_URL=redis://127.0.0.1:6379/0
SON_MINIO_ENDPOINT=127.0.0.1:9000
SON_MINIO_ACCESS_KEY=sonminio
SON_MINIO_SECRET_KEY=sonminio_local_only
SON_MINIO_BUCKET=sonstudio

SON_API_PORT=8000
SON_WEB_PORT=5173

# Model artifacts never go into Git; .gitignore covers *.gguf, *.safetensors,
# /models/ and /artifacts/.
SON_MODELS_DIR=D:/SystemOneStudio/models
