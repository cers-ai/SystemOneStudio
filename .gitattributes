# Normalize to LF in the repo, check out per-platform.
# Without this, git rewrites every file to CRLF on the Windows working tree and
# diffs get noisy the moment a file is edited on a different OS.
* text=auto eol=lf

# Binary artifacts: never line-ending translated, never diffed.
*.gguf binary
*.safetensors binary
*.bin binary
*.parquet binary
*.png binary
*.jpg binary
*.ico binary

# Lockfiles are text and must stay diffable: a dependency change is exactly
# when a reviewer needs to read the diff. Only line endings are normalized.
package-lock.json text eol=lf
uv.lock text eol=lf

# Preserve original source/archive bytes so recorded SHA-256 survives a clone.
SystemOneStudio-demo-v3.html -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
SystemOneStudio_判断模型技术方案_v3.md -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/archive/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/audit/2026-10-06/项目审计.md -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/audit/**/*.txt whitespace=-blank-at-eof
